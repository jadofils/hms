# Notification — references User (actor) only; nothing else depends on it.
# payload/channels/status/recipients mirror NotificationResponse's own shape exactly
# (opaque JSON strings / a plain string list — see NotificationService's Javadoc for why).

type Notification {
    notificationId: ID!
    type: String!
    actorUserId: ID
    actorUsername: String
    recipients: [String!]!
    payload: String
    channels: String
    status: String
    priority: String!
    readAt: LocalDateTime
    createdAt: LocalDateTime!
}

input NotificationInput {
    type: String!
    actorUserId: ID
    recipients: [String!]!
    payload: String
    channels: String
    status: String
    priority: String
}

extend type Query {
    """Sortable columns: notificationId, type, status, priority, readAt, createdAt,
    updatedAt. `sort` uses the same "property,direction" format REST's own `?sort=`
    query param does (e.g. "createdAt,desc"). `unread` optionally filters to only
    unread (`true`) or only already-read (`false`) notifications — omitted returns
    every notification."""
    notifications(page: Int! = 0, size: Int! = 20, sort: String, unread: Boolean): [Notification!]!
    notification(notificationId: ID!): Notification
}

extend type Mutation {
    createNotification(input: NotificationInput!): Notification!
    updateNotification(notificationId: ID!, input: NotificationInput!): Notification!
    markNotificationAsRead(notificationId: ID!): Notification!
    deleteNotification(notificationId: ID!): Boolean!
}
