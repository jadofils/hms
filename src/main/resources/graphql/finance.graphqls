# Invoice — references Appointment+Patient, no other table depends on it.

type Invoice {
    invoiceId: ID!
    appointment: Appointment!
    patient: Patient!
    totalAmount: BigDecimal!
    paymentStatus: String!
    issuedAt: LocalDateTime!
}

input InvoiceInput {
    appointmentId: ID!
    patientId: ID!
    totalAmount: BigDecimal
    paymentStatus: String
}

extend type Query {
    """Sortable columns: invoiceId, totalAmount, paymentStatus, issuedAt, updatedAt.
    `sort` uses the same "property,direction" format REST's own `?sort=` query param
    does (e.g. "issuedAt,desc"). `paymentStatus` optionally filters the list — e.g. a
    billing follow-up worklist of every unpaid invoice."""
    invoices(page: Int! = 0, size: Int! = 20, sort: String, paymentStatus: String): [Invoice!]!
    invoice(invoiceId: ID!): Invoice
}

extend type Mutation {
    createInvoice(input: InvoiceInput!): Invoice!
    updateInvoice(invoiceId: ID!, input: InvoiceInput!): Invoice!
    deleteInvoice(invoiceId: ID!): Boolean!
}
