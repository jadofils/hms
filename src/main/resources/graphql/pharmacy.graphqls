# Pharmacy cluster — one connected FK component: MedicalInventory->Medication,
# PrescriptionItem->Prescription+Medication, Prescription->Appointment.

type Medication {
    medicationId: ID!
    name: String!
    genericName: String
    form: String
    unitPrice: BigDecimal
}

type MedicalInventory {
    inventoryId: ID!
    medication: Medication!
    batchNumber: String
    expiryDate: Date!
    quantityInStock: Int!
    reorderLevel: Int!
    supplier: String
}

type Prescription {
    prescriptionId: ID!
    appointment: Appointment!
    dateIssued: Date!
    items: [PrescriptionItem!]!
}

type PrescriptionItem {
    itemId: ID!
    prescriptionId: ID!
    medication: Medication!
    dosage: String
    quantity: Int!
    instructions: String
}

input MedicationInput {
    name: String!
    genericName: String
    form: String
    unitPrice: BigDecimal
}

input MedicalInventoryInput {
    medicationId: ID!
    batchNumber: String
    expiryDate: Date!
    quantityInStock: Int
    reorderLevel: Int
    supplier: String
}

input PrescriptionInput {
    appointmentId: ID!
    dateIssued: Date
}

input PrescriptionItemInput {
    medicationId: ID!
    dosage: String
    quantity: Int!
    instructions: String
}

extend type Query {
    """Sortable columns: medicationId, name, genericName, form, unitPrice, createdAt,
    updatedAt. `sort` uses the same "property,direction" format REST's own `?sort=`
    query param does (e.g. "name,asc"). `lowStock: true` narrows to medications needing
    reorder across any of their own batches (distinct from `inventoryRecords(lowStock:
    true)`, which lists the individual low batches rather than the medications)."""
    medications(page: Int! = 0, size: Int! = 20, sort: String, lowStock: Boolean): [Medication!]!
    medication(medicationId: ID!): Medication
    """Sortable columns: inventoryId, batchNumber, expiryDate, quantityInStock,
    reorderLevel, supplier, createdAt, updatedAt. `sort` uses the same
    "property,direction" format REST's own `?sort=` query param does (e.g.
    "expiryDate,asc"). `lowStock`/`medicationId` are independent, mutually
    exclusive filters - `lowStock` wins if both are given."""
    inventoryRecords(page: Int! = 0, size: Int! = 20, sort: String, medicationId: ID, lowStock: Boolean): [MedicalInventory!]!
    inventoryRecord(inventoryId: ID!): MedicalInventory
    """Sortable columns: prescriptionId, dateIssued, createdAt, updatedAt. `sort` uses
    the same "property,direction" format REST's own `?sort=` query param does (e.g.
    "dateIssued,desc"). Optional `patientId` filters to one patient's own prescription
    history."""
    prescriptions(page: Int! = 0, size: Int! = 20, sort: String, patientId: ID): [Prescription!]!
    prescription(prescriptionId: ID!): Prescription
    prescriptionItems(prescriptionId: ID!): [PrescriptionItem!]!
}

extend type Mutation {
    createMedication(input: MedicationInput!): Medication!
    updateMedication(medicationId: ID!, input: MedicationInput!): Medication!
    deleteMedication(medicationId: ID!): Boolean!

    createInventoryRecord(input: MedicalInventoryInput!): MedicalInventory!
    updateInventoryRecord(inventoryId: ID!, input: MedicalInventoryInput!): MedicalInventory!
    deleteInventoryRecord(inventoryId: ID!): Boolean!

    createPrescription(input: PrescriptionInput!): Prescription!
    updatePrescription(prescriptionId: ID!, input: PrescriptionInput!): Prescription!
    deletePrescription(prescriptionId: ID!): Boolean!

    createPrescriptionItem(prescriptionId: ID!, input: PrescriptionItemInput!): PrescriptionItem!
    updatePrescriptionItem(prescriptionId: ID!, itemId: ID!, input: PrescriptionItemInput!): PrescriptionItem!
    deletePrescriptionItem(prescriptionId: ID!, itemId: ID!): Boolean!
}
