# Patient — standalone (no FK dependency on any other cluster); referenced *from*
# appointment.graphqls/finance.graphqls, not the other way around.

type Patient {
    patientId: ID!
    firstName: String!
    lastName: String!
    dob: Date!
    gender: String!
    phone: String
    email: String
    address: String
    status: String!
}

input PatientInput {
    firstName: String!
    lastName: String!
    dob: Date!
    gender: String!
    phone: String
    email: String
    address: String
    status: String
}

extend type Query {
    """Sortable columns: patientId, firstName, lastName, dob, gender, phone, email,
    address, status. `sort` uses the same "property,direction" format REST's own
    `?sort=` query param does (e.g. "lastName,desc") — omitted or unrecognized falls
    back to `patientId` ascending. `status`/`gender` optionally filter the list.
    `minAge`, when given, wins over both and returns every patient at least that many
    years old (a native SQL query — Postgres' AGE() function has no portable JPQL
    equivalent)."""
    patients(page: Int! = 0, size: Int! = 20, sort: String, status: String, gender: String, minAge: Int): [Patient!]!
    patient(patientId: ID!): Patient
}

extend type Mutation {
    createPatient(input: PatientInput!): Patient!
    updatePatient(patientId: ID!, input: PatientInput!): Patient!
    deletePatient(patientId: ID!): Boolean!
}
