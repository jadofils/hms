# Patient — standalone (no FK dependency on any other cluster); referenced *from*
# appointment.graphqls/finance.graphqls, not the other way around.

type Patient {
    patientId: ID!
    firstName: String!
    lastName: String!
    dob: Date!
    gender: String!
    phone: String
    email: String
    address: String
    status: String!
}

input PatientInput {
    firstName: String!
    lastName: String!
    dob: Date!
    gender: String!
    phone: String
    email: String
    address: String
    status: String
}

extend type Query {
    patients(page: Int! = 0, size: Int! = 20, status: String, gender: String): [Patient!]!
    patient(patientId: ID!): Patient
}

extend type Mutation {
    createPatient(input: PatientInput!): Patient!
    updatePatient(patientId: ID!, input: PatientInput!): Patient!
    deletePatient(patientId: ID!): Boolean!
}
