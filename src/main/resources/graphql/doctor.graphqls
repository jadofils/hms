# Doctor/Department/DoctorSchedule cluster — DoctorSchedule->Doctor, Doctor<->Department
# many-to-many.

type Doctor {
    doctorId: ID!
    firstName: String!
    lastName: String!
    specialization: String
    phone: String
    email: String
    departments: [Department!]!
}

type Department {
    departmentId: ID!
    name: String!
    location: String
    phone: String
    doctors: [Doctor!]!
}

type DoctorSchedule {
    scheduleId: ID!
    doctorId: ID!
    dayOfWeek: String!
    startTime: LocalTime!
    endTime: LocalTime!
    isAvailable: Boolean!
}

input DoctorInput {
    firstName: String!
    lastName: String!
    specialization: String
    phone: String
    email: String
    # Required (at least one id) on create, ignored on update — department membership
    # is managed by the assignDepartment/removeDepartment mutations below. Optional
    # here rather than [ID!]! for the same reason DoctorRequest.departmentIds isn't
    # @NotEmpty: this one input type backs both createDoctor and updateDoctor.
    departmentIds: [ID!]
}

"""Partial-update counterpart to DoctorInput — every field optional; only the ones
present in the request get changed. No departmentIds — that's managed by
assignDepartment/removeDepartment instead, same as updateDoctor."""
input PatchDoctorInput {
    firstName: String
    lastName: String
    specialization: String
    phone: String
    email: String
}

input DepartmentInput {
    name: String!
    location: String
    phone: String
}

"""Partial-update counterpart to DepartmentInput — every field optional; only the ones
present in the request get changed."""
input PatchDepartmentInput {
    name: String
    location: String
    phone: String
}

input DoctorScheduleInput {
    dayOfWeek: String!
    startTime: LocalTime!
    endTime: LocalTime!
    isAvailable: Boolean
}

"""Partial-update counterpart to DoctorScheduleInput — every field optional; only the
ones present in the request get changed."""
input PatchDoctorScheduleInput {
    dayOfWeek: String
    startTime: LocalTime
    endTime: LocalTime
    isAvailable: Boolean
}

extend type Query {
    """Sortable columns: doctorId, firstName, lastName, specialization, phone, email.
    `sort` uses the same "property,direction" format REST's own `?sort=` query param
    does (e.g. "lastName,desc") — omitted or unrecognized falls back to `doctorId`
    ascending."""
    doctors(page: Int! = 0, size: Int! = 20, sort: String): [Doctor!]!
    doctor(doctorId: ID!): Doctor
    """Sortable columns: departmentId, name, location, phone, createdAt, updatedAt.
    `sort` uses the same "property,direction" format REST's own `?sort=` query param
    does (e.g. "name,asc")."""
    departments(page: Int! = 0, size: Int! = 20, sort: String): [Department!]!
    department(departmentId: ID!): Department
    doctorSchedules(doctorId: ID!): [DoctorSchedule!]!
    doctorAvailability(doctorId: ID!, day: String!, time: String!): Boolean!
}

extend type Mutation {
    createDoctor(input: DoctorInput!): Doctor!
    updateDoctor(doctorId: ID!, input: DoctorInput!): Doctor!
    patchDoctor(doctorId: ID!, input: PatchDoctorInput!): Doctor!
    deleteDoctor(doctorId: ID!): Boolean!
    assignDepartment(doctorId: ID!, departmentId: ID!): Doctor!
    removeDepartment(doctorId: ID!, departmentId: ID!): Doctor!

    createDepartment(input: DepartmentInput!): Department!
    updateDepartment(departmentId: ID!, input: DepartmentInput!): Department!
    patchDepartment(departmentId: ID!, input: PatchDepartmentInput!): Department!
    deleteDepartment(departmentId: ID!): Boolean!

    createDoctorSchedule(doctorId: ID!, input: DoctorScheduleInput!): DoctorSchedule!
    updateDoctorSchedule(doctorId: ID!, scheduleId: ID!, input: DoctorScheduleInput!): DoctorSchedule!
    patchDoctorSchedule(doctorId: ID!, scheduleId: ID!, input: PatchDoctorScheduleInput!): DoctorSchedule!
    deleteDoctorSchedule(doctorId: ID!, scheduleId: ID!): Boolean!
}
