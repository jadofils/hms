# Read-only — SystemLog has no mutations (LoggingAspect/SystemLogWriter are the only
# writer; a log row is never edited once written — see SystemLogService's Javadoc).

type SystemLog {
    logId: ID!
    logLevel: String!
    source: String
    message: String!
    userId: ID
    createdAt: LocalDateTime!
}

extend type Query {
    """Sortable columns: logId, logLevel, source, createdAt. `sort` uses the same
    "property,direction" format REST's own `?sort=` query param does. `logLevel`
    (exact match) and `source` (case-insensitive contains) filters are optional and
    independently combinable."""
    systemLogs(page: Int! = 0, size: Int! = 20, sort: String, logLevel: String, source: String): [SystemLog!]!
    systemLog(logId: ID!): SystemLog
}
