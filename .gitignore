HELP.md
target/
.mvn/wrapper/maven-wrapper.jar

# Prometheus's own local TSDB storage — prometheus.cmd runs prometheus.exe with the
# process's cwd as the repo root and no --storage.tsdb.path override, so it writes its
# database here by default. Runtime data, not source — never commit it.
/data/

# Project instructions for Claude Code — kept local, not published to the repo
CLAUDE.md

# Real secrets (DB/Redis passwords, encryption key, Gmail app password) — never commit
.env

# Google Cloud Console's downloaded OAuth2 client credentials file — contains a live
# client_secret in plaintext. The actual client id/secret get copied into .env (same
# secret-management convention as everything else above) and referenced via
# spring.security.oauth2.client.registration.google.* in application.yaml; this raw
# download is never the thing the app actually reads at runtime, so ignoring it costs
# nothing. Matches Google's own default download filename pattern.
docs/client_secret_*.json

# Claude Code local session/tooling state (per-machine MCP toggles, settings, scheduled-
# task locks, etc.) — none of it is meant to be shared or pushed.
.claude/

# Local SonarQube tooling scripts — sonarqube.cmd hardcodes this machine's SonarQube
# install path, and jacoco.cmd is meant to hold a real Sonar auth token once filled in.
# Neither is portable to another dev's machine or CI, and the token must never be
# committed. Keep a template of each (without a real path/token) if these need sharing.
sonarqube.cmd
jacoco.cmd
!**/src/main/**/target/
!**/src/test/**/target/

