config.stopBubbling = true

# Lets @Lazy on a field survive onto the parameter of Lombok's generated
# @RequiredArgsConstructor — needed for the self-injection pattern used by
# UserService/RoleService (see CLAUDE.md's "Self-injection" AOP section) to
# break the circular dependency a self-reference field creates at
# bean-creation time.
lombok.copyableAnnotations += org.springframework.context.annotation.Lazy

# Lets @Value survive onto the constructor parameter too, so a simple
# property (e.g. AuthService.frontendBaseUrl) can stay a final,
# constructor-injected field alongside the class's real collaborators
# instead of falling back to mutable field injection.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value